{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noEmit": false,
    "noImplicitAny": false,
    "outDir": "../../dist/apps/api",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@ims/shared": ["../../dist/packages/shared"],
      "@ims/shared/*": ["../../dist/packages/shared/*"],
      "@ims/types": ["../../dist/packages/types"],
      "@ims/types/*": ["../../dist/packages/types/*"],
      "@ims/database": ["../../dist/packages/database"],
      "@ims/database/*": ["../../dist/packages/database/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}