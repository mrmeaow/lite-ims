# Production Environment Variables
# =================================
# Copy this file to .env and configure for production
# 
# Production Services:
# - Database: Neon PostgreSQL (free-tier)
# - Redis: Upstash Redis (free-tier)
# - Hosting: Render.com (free-tier)

# ============================================
# Database (Neon - https://neon.tech)
# ============================================
# Get your connection string from Neon dashboard
# Format: postgresql://user:password@host.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@ep-xxx-xxx.us-east-2.aws.neon.tech/ims?sslmode=require"

# ============================================
# Redis (Upstash - https://upstash.com)
# ============================================
# Get your Redis URL from Upstash dashboard
# Format: redis://default:password@host.upstash.io:port
REDIS_URL="redis://default:xxx@xxx.upstash.io:6379"

# ============================================
# JWT Configuration
# ============================================
# Generate a strong secret (min 32 characters)
# Use: openssl rand -base64 32
JWT_SECRET="your-super-secret-jwt-key-at-least-32-characters"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# ============================================
# Server Configuration
# ============================================
NODE_ENV="production"
PORT=3030

# ============================================
# CORS Configuration
# ============================================
# Your production domain (Render URL)
CORS_ORIGIN="https://your-app.onrender.com"

# ============================================
# Cookie Configuration
# ============================================
COOKIE_NAME="ims_access_token"
COOKIE_MAX_AGE=900000
