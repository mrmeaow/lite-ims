{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "noImplicitAny": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "baseUrl": ".",
    "paths": {
      "@ims/shared": ["../../packages/shared/dist"],
      "@ims/shared/*": ["../../packages/shared/dist/*"],
      "@ims/types": ["../../packages/types/dist"],
      "@ims/types/*": ["../../packages/types/dist/*"],
      "@ims/database": ["../../packages/database/dist"],
      "@ims/database/*": ["../../packages/database/dist/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}